# ==============================================================================
# Spoken English AI Tutoring Platform Configuration
# ==============================================================================

# Operation Mode: 'cloud' (uses OpenAI/Groq keys, low latency) or 'local' (runs completely offline)
MODEL_MODE=cloud

# FastAPI Server Configurations
PORT=8000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# Cloud APIs (Required for 'cloud' mode)
# ------------------------------------------------------------------------------

# OpenAI API Key (Required for cloud Whisper STT, fallback OpenAI TTS, and GPT-4o-mini LLM)
OPENAI_API_KEY=your-openai-api-key-here

# Groq API Key (Fastest LLM responses for tutor brain conversation and corrections)
GROQ_API_KEY=your-groq-api-key-here

# ElevenLabs API Key (Optional: for premium custom teacher voices)
ELEVENLABS_API_KEY=

# ------------------------------------------------------------------------------
# Local Configuration (Used when MODEL_MODE=local)
# ------------------------------------------------------------------------------

# Local Whisper model size (tiny, base, small, medium, large-v3)
# 'base' or 'small' is recommended for Mac CPU/MPS
LOCAL_WHISPER_MODEL=base

# Local LLM huggingface identifier (must be an instruct/chat tuned model)
# 'Qwen/Qwen2.5-1.5B-Instruct' runs very fast on standard Mac CPU/MPS
LOCAL_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# Local Kokoro TTS Voice model (e.g. af_bella, af_sarah, am_adam, etc.)
LOCAL_TTS_VOICE=af_bella
